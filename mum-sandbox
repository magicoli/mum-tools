#!/bin/bash
#
# Reproducible local test environment for the MUM ecosystem.
#
# Builds two lerd sites that mirror the production topology:
#
#   mum-server.test   UpdatePulse Server — the package/license server (gotye's role)
#   mum-client.test   a managed site running magiiic-update-manager (a client site's role)
#
# The server runs a copy of contrib/updatepulse-server with our pending upstream
# patches applied; the client symlinks plugins/magiiic-update-manager so our own
# code can be edited live and tested immediately.
#
# Everything lives under sandbox/, which is gitignored: this environment is
# disposable and rebuilt from scratch by `mum-sandbox create`.

set -u

PGM=$(basename "$0")
BASEDIR=$(cd "$(dirname "$0")/.." && pwd)
SANDBOX="$BASEDIR/sandbox"
WPCLI="$SANDBOX/wp-cli.phar"

SERVER_SITE=mum-server
CLIENT_SITE=mum-client
SERVER_DIR="$SANDBOX/$SERVER_SITE"
CLIENT_DIR="$SANDBOX/$CLIENT_SITE"
SERVER_URL="https://$SERVER_SITE.test"
CLIENT_URL="https://$CLIENT_SITE.test"

# Sandbox-only credentials. Never used outside this machine.
ADMIN_USER=magic
ADMIN_PASS=sandbox-local-only
ADMIN_MAIL=olivier@van-helden.net
API_KEY_ID=sandbox
API_KEY=ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12ab12

COLOR_TITLE="\033[1;33m"
COLOR_OK="\033[0;32m"
COLOR_ERR="\033[1;31m"
COLOR_OFF="\033[0m"

log() { printf "${COLOR_TITLE}%s:${COLOR_OFF} %s\n" "$PGM" "$*"; }
ok() { printf "${COLOR_OK}%s:${COLOR_OFF} %s\n" "$PGM" "$*"; }
die() {
	printf "${COLOR_ERR}%s:${COLOR_OFF} %s\n" "$PGM" "$*" >&2
	exit 1
}

usage() {
	cat <<EOF
$PGM — local test environment for the MUM ecosystem

Usage: $PGM <command>

  create     Build both sandbox sites (idempotent, skips what already exists)
  status     Show what is running and what is registered on the server
  sync       Refresh the server's plugin copy from contrib/ and re-apply patches
  publish    Push a package to the sandbox server: $PGM publish <plugin-dir>
  destroy    Unlink the sites and delete sandbox/ site directories
  reset      destroy + create

Sites:
  $SERVER_URL   UpdatePulse Server (package + license server)
  $CLIENT_URL   client site running magiiic-update-manager
EOF
}

# wp-cli must run inside the site's container to reach the lerd database.
wp() {
	local dir=$1
	shift
	( cd "$dir" && lerd php "$WPCLI" --allow-root "$@" )
}

require_tools() {
	for tool in lerd curl php; do
		command -v $tool >/dev/null || die "missing $tool"
	done
}

fetch_tools() {
	[ -f "$WPCLI" ] && return
	log "downloading wp-cli"
	curl -sSL -o "$WPCLI" \
		https://github.com/wp-cli/wp-cli/releases/download/v2.12.0/wp-cli-2.12.0.phar \
		|| die "could not download wp-cli"
}

# Install WordPress core, register the site with lerd and create its database.
create_site() {
	local dir=$1 site=$2 url=$3 title=$4

	if [ -d "$dir" ]; then
		log "$site already exists, skipping"
		return
	fi

	log "creating $site"
	mkdir -p "$dir"
	curl -sSL https://wordpress.org/latest.tar.gz \
		| tar -xz -C "$dir" --strip-components=1 \
		|| die "could not download WordPress"

	cat > "$dir/.lerd.yaml" <<EOF
domains:
  - $site
php_version: "8.4"
framework: wordpress
secured: true
services:
  - mysql
EOF

	( cd "$dir" && lerd link >/dev/null ) || die "lerd link failed for $site"
	( cd "$dir" && lerd db:create >/dev/null 2>&1 )

	local dbname
	dbname=$(echo "$site" | tr '-' '_')

	cat > "$dir/wp-config.php" <<EOF
<?php
/** Sandbox instance — local only, credentials are deliberately trivial. */

define( 'DB_NAME', '$dbname' );
define( 'DB_USER', 'root' );
define( 'DB_PASSWORD', 'lerd' );
define( 'DB_HOST', 'lerd-mysql' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

define( 'AUTH_KEY',         'sandbox-$site-auth' );
define( 'SECURE_AUTH_KEY',  'sandbox-$site-secure-auth' );
define( 'LOGGED_IN_KEY',    'sandbox-$site-logged-in' );
define( 'NONCE_KEY',        'sandbox-$site-nonce' );
define( 'AUTH_SALT',        'sandbox-$site-auth-salt' );
define( 'SECURE_AUTH_SALT', 'sandbox-$site-secure-auth-salt' );
define( 'LOGGED_IN_SALT',   'sandbox-$site-logged-in-salt' );
define( 'NONCE_SALT',       'sandbox-$site-nonce-salt' );

\$table_prefix = 'wp_';

define( 'WP_HOME', '$url' );
define( 'WP_SITEURL', '$url' );
define( 'WP_DEBUG', true );
define( 'WP_DEBUG_LOG', true );
define( 'WP_DEBUG_DISPLAY', false );

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

require_once ABSPATH . 'wp-settings.php';
EOF

	wp "$dir" core install \
		--url="$url" --title="$title" \
		--admin_user="$ADMIN_USER" --admin_password="$ADMIN_PASS" \
		--admin_email="$ADMIN_MAIL" --skip-email >/dev/null \
		|| die "WordPress install failed for $site"

	# UpdatePulse and MUM both route through rewrite rules.
	wp "$dir" rewrite structure '/%postname%/' >/dev/null 2>&1
	ok "$site installed — $url"
}

# The server runs a *copy* of the submodule, so the pending upstream patches can
# be applied without dirtying contrib/ (which tracks upstream verbatim).
sync_server_plugin() {
	local dest="$SERVER_DIR/wp-content/plugins/updatepulse-server"

	log "syncing updatepulse-server from contrib/"
	rsync -a --delete --exclude .git \
		"$BASEDIR/contrib/updatepulse-server/" "$dest/" \
		|| die "could not copy updatepulse-server"

	for patch in "$BASEDIR"/patches/updatepulse-server-*.patch; do
		[ -f "$patch" ] || continue
		if patch -s -p1 -d "$dest" --forward < "$patch"; then
			log "applied $(basename "$patch")"
		else
			die "could not apply $(basename "$patch")"
		fi
	done
}

setup_server() {
	create_site "$SERVER_DIR" "$SERVER_SITE" "$SERVER_URL" "MUM sandbox — package server"
	sync_server_plugin
	wp "$SERVER_DIR" plugin activate updatepulse-server >/dev/null 2>&1

	# Declare the API key the sandbox pushes packages with. Deliberately scoped
	# without 'delete', so accidental destructive calls are refused.
	wp "$SERVER_DIR" eval "
		upserv_update_option(
			'api/packages/private_api_keys',
			array( '$API_KEY_ID' => array(
				'key'    => '$API_KEY',
				'access' => array( 'add', 'edit', 'read', 'browse' ),
			) )
		);
	" >/dev/null 2>&1 || die "could not declare the sandbox API key"

	wp "$SERVER_DIR" rewrite flush --hard >/dev/null 2>&1
	ok "package server ready — $SERVER_URL"
}

setup_client() {
	create_site "$CLIENT_DIR" "$CLIENT_SITE" "$CLIENT_URL" "MUM sandbox — client site"

	# Our own plugin is symlinked, not copied: edit plugins/ and test right away.
	local dest="$CLIENT_DIR/wp-content/plugins/magiiic-update-manager"
	[ -e "$dest" ] || ln -s "$BASEDIR/plugins/magiiic-update-manager" "$dest"
	wp "$CLIENT_DIR" plugin activate magiiic-update-manager >/dev/null 2>&1

	# Point MUM at the sandbox server. Harmless until MUM learns to read it
	# (Phase 4); dropped here so the switch is testable the moment it lands.
	mkdir -p "$CLIENT_DIR/wp-content/mu-plugins"
	cat > "$CLIENT_DIR/wp-content/mu-plugins/mum-sandbox-server.php" <<EOF
<?php
/** Sandbox: point magiiic-update-manager at the local package server. */

add_filter( 'mum_server_url', function () {
	return '$SERVER_URL';
} );

add_filter( 'mum_server_key', function () {
	return '$API_KEY_ID|$API_KEY';
} );
EOF
	ok "client site ready — $CLIENT_URL"
}

cmd_create() {
	require_tools
	mkdir -p "$SANDBOX"
	fetch_tools
	setup_server
	setup_client
	echo
	cmd_status
}

cmd_status() {
	printf "${COLOR_TITLE}sites${COLOR_OFF}\n"
	for site in "$SERVER_SITE" "$CLIENT_SITE"; do
		local dir="$SANDBOX/$site"
		if [ -d "$dir" ]; then
			printf "  %-14s %s  " "$site" "https://$site.test"
			curl -sk -o /dev/null -w "HTTP %{http_code}\n" "https://$site.test/"
		else
			printf "  %-14s not created\n" "$site"
		fi
	done

	[ -d "$SERVER_DIR" ] || return 0

	printf "\n${COLOR_TITLE}packages on the server${COLOR_OFF}\n"
	local packages
	packages=$(ls "$SERVER_DIR/wp-content/uploads/updatepulse-server/packages/" 2>/dev/null)
	if [ -z "$packages" ]; then
		echo "  (none — use '$PGM publish <plugin-dir>')"
	else
		echo "$packages" | sed 's/^/  /'
	fi
}

cmd_publish() {
	[ $# -ge 1 ] || die "usage: $PGM publish <plugin-dir>"
	[ -d "$SERVER_DIR" ] || die "sandbox not created — run '$PGM create'"

	"$BASEDIR/bin/mum-push" \
		--server "$SERVER_URL" \
		--key-id "$API_KEY_ID" \
		--key "$API_KEY" \
		"$1"
}

cmd_destroy() {
	for site in "$SERVER_SITE" "$CLIENT_SITE"; do
		local dir="$SANDBOX/$site"
		[ -d "$dir" ] || continue
		log "removing $site"
		( cd "$dir" && lerd unlink >/dev/null 2>&1 )
		rm -rf "$dir"
	done
	ok "sandbox removed (databases are left in place)"
}

case "${1:-}" in
	create) cmd_create ;;
	status) cmd_status ;;
	sync)
		[ -d "$SERVER_DIR" ] || die "sandbox not created — run '$PGM create'"
		sync_server_plugin
		ok "server plugin refreshed"
		;;
	publish)
		shift
		cmd_publish "$@"
		;;
	destroy) cmd_destroy ;;
	reset)
		cmd_destroy
		cmd_create
		;;
	""|-h|--help|help) usage ;;
	*) die "unknown command '$1' — try '$PGM --help'" ;;
esac
