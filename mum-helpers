#!/usr/bin/env bash
#
# What the dev-site scripts all need: where the sites are, what they are called,
# and how to talk to them.
#
# Sourced, never run. Sharing one description of the environment is the only way
# they stay describing the same one.

# Make sure we were not launched twice
[ -n "${MUM_HELPERS:-}" ] && return || MUM_HELPERS=$(realpath "$BASH_SOURCE")

[ -n "${BASH_SOURCE[0]:-}" ] && [ "${BASH_SOURCE[0]}" = "$0" ] && {
	echo "$(basename "$0") is meant to be sourced, not run" >&2
	exit 1
}

BINDIR="$(cd $(dirname $BASH_SOURCE) && pwd)"
BASEDIR="${BASEDIR:-$(dirname "$BINDIR")}"
DEVDIR="${DEVDIR:-$BASEDIR/dev}"
[ -n "${BASH_HELPERS:-}" ] || source $BINDIR/helpers

# bin/helpers is responsible for loading $BASEDIR/.env
# other .env files are meant to be loaded by the scripts requiring it, not
# by these project-wide helpers

# Two environments -- dev and tests -- with the same two sites each: a package
# server and a managed client, which talk to each other and never across.
#
#   dev     kept, served however this machine serves sites, and the developer's
#   tests   rebuilt whenever, served by PHP itself, and nobody's
#
# The caller says which by setting MUM_ENV before sourcing this. Everything
# below is that one word, so the two can never be half-mixed.
MUM_ENV=${MUM_ENV:-dev}

case $MUM_ENV in
	dev | tests) ;;
	*) die "no such environment: $MUM_ENV (dev or tests)" ;;
esac

# -site tells the site apart from the plugin of the same name; -dev and -tests
# tell the environments apart. Both are needed, and neither replaces the other.
#
# .test is what lerd and Herd answer to; another machine serves these somewhere
# else, and says so in .env rather than being told what its own domains are.
MUM_SERVER_SLUG=${MUM_SERVER_SLUG:-mum-server-$MUM_ENV-site}
MUM_SERVER_HOST=${MUM_SERVER_HOST:-${MUM_SERVER_SLUG}.test}
MUM_SERVER_DB=${MUM_SERVER_DB:-mum_server_$MUM_ENV}
MUM_CLIENT_SLUG=${MUM_CLIENT_SLUG:-mum-client-$MUM_ENV-site}
MUM_CLIENT_HOST=${MUM_CLIENT_HOST:-${MUM_CLIENT_SLUG}.test}
MUM_CLIENT_DB=${MUM_CLIENT_DB:-mum_client_$MUM_ENV}
MUM_RELEASE_VERSION=${MUM_RELEASE_VERSION:-1.5}
MUM_CLIENT_VERSION=${MUM_CLIENT_VERSION:-1.4}

# The development sites are kept and looked at, so they live where a developer
# expects them. The tests ones are built again whenever, so they live where
# nothing is kept -- and are gitignored either way.
SITES_DIR=$DEVDIR
[ "$MUM_ENV" = tests ] && SITES_DIR=$BASEDIR/tests/sites

SERVER_DIR=$SITES_DIR/$MUM_SERVER_SLUG
CLIENT_DIR=$SITES_DIR/$MUM_CLIENT_SLUG
BUILT_DIR=$BASEDIR/plugins/mum-demo-packages/build/$MUM_SERVER_HOST

# The packages carrying a licence, and what each one is. Named once: the server
# issues the licences, the client presents them, and the two lists have to be
# the same list.
LICENSED_PLUGINS=(dummy-plugin-lib-license)
LICENSED_THEMES=(dummy-theme-lib-license)

# wp-cli, with whatever the caller decided about root. wp-cli refuses to run as
# root and lerd runs its containers as root; an alias covers that in a terminal
# and does not survive into a script, so it is asked for rather than assumed.
allow_root=${allow_root:-}
wp() {
	"$BASEDIR/vendor/bin/wp" ${allow_root:+"$allow_root"} "$@"
}

# Run from inside the site directory: that is how the environment serving it
# decides which database and which PHP the command gets.
wp_server() {
	cd "$SERVER_DIR" && wp --path="$SERVER_DIR" "$@"
}

wp_client() {
	cd "$CLIENT_DIR" && wp --path="$CLIENT_DIR" "$@"
}
