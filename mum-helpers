#!/usr/bin/env bash
#
# What the dev-site scripts all need: where the sites are, what they are called,
# and how to talk to them.
#
# Sourced, never run. Sharing one description of the environment is the only way
# they stay describing the same one.

# Make sure we were not launched twice
[ -n "${MUM_HELPERS:-}" ] && return || MUM_HELPERS=$(realpath "$BASH_SOURCE")

[ -n "${BASH_SOURCE[0]:-}" ] && [ "${BASH_SOURCE[0]}" = "$0" ] && {
	echo "$(basename "$0") is meant to be sourced, not run" >&2
	exit 1
}

PID=$$
PGM=${PGM:-$(basename "$0")}
BINDIR="$(cd $(dirname $BASH_SOURCE) && pwd)"
BASEDIR="${BASEDIR:-$(dirname "$BINDIR")}"
DEVDIR="${DEVDIR:-$BASEDIR/dev}"
echo ":$PATH:" | grep -q ":$BINDIR:" || export PATH="$BINDIR:$PATH"

TMP=${TMP:-$(mktemp -t $PGM 2>/dev/null || mktemp -t $PGM.XXXXX 2>/dev/null || echo /tmp/$PGM.$$)}
LOCK=/tmp/$PGM.lock
trap 'rm -f $TMP.* $LOCK' EXIT

DEBUG=${DEBUG:-}

RED="\033[1;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
STD="\033[0m"

## Generic tools

# Utility functions for true/false checking
is_true() {
	lower=$(echo "${1:-}" | tr "[:upper:]" "[:lower:]")
	case "$lower" in
	yes | y | on | true | 1) return 0 ;;
	*) return 1 ;;
	esac
}

is_false() {
	lower=$(echo "${1:-}" | tr "[:upper:]" "[:lower:]")
	case "$lower" in
	no | n | off | false | 0) return 0 ;;
	# "") return 0 ;;  # Empty is not false, it's null
	*) return 1 ;; # Unknown is false
	esac
}

# Debug checking function
debug_mode() {
	is_true "$DEBUG"
}

log() {
	[ -z "$1" ] && return
	local append err

	err=$(echo "$1" | grep -E "^[0-9]+$" || true)
	[ -z "$err" ] || shift

	case "$err" in
	0) COLOR=${GREEN} ;;
	"") COLOR=${YELLOW} ;;
	*)
		COLOR="$RED"
		append=" ($err)"
		;;
	esac

	[ "${1:-}" = "-n" ] && n="-n" && shift || n=
	[ -n "$*" ] || return
	printf "${COLOR}%s:${STD} %s\n" "$PGM" "$*${append:-}"
}

debug() {
	debug_mode && log "$*"
}

success() {
	log 0 "$@"
}

error() {
	local err=$(echo "$1" | grep -E "^[0-9]+$" || true)
	[ -z "$err" ] || shift
	[ ${err:-0} -ne 0 ] || err=1
	log ${err:-1} "$*"
}

end() {
	local caller_file="${BASH_SOURCE[1]}"
	local caller_line="${BASH_LINENO[0]}"
	# err=$(echo "$1" | grep -E "^[1-9][0-9]*$" || true)
	local err=$(echo "${1:-}" | grep -E "^[0-9]+$" && shift || false)
	[ -z "$err" ] || shift
	if [ "$err" -a "$err" != "0" ]; then
		prefix="[ERROR]"
		debug_mode && suffix="$caller_file:$caller_line" || suffix=
	else
		prefix=
		suffix=
	fi

	[ "${1:-}" = "-n" ] && n="-n" && shift || n=
	local message=${@:-$(debug_mode && echo Finished processing)}
	log $err $prefix "$message"
	[ -n "$suffix" ] && echo "  trace: $suffix"
	exit ${err:-0}
}

die() {
	local err=$(echo "${1:-}" | grep -E "^[0-9]+$" || true)
	[ -z "$err" ] || shift
	[ ${err:-0} -ne 0 ] || err=1
	end $err "$@"
}

yesno() {
	default=n
	choice="y/N"
	[ "$1" = "y" ] && default=y && choice="Y/n" && shift
	[ "$1" = "-y" ] && default=y && choice="Y/n" && shift
	[ "$@" ] && message="$@" || message="Answer"
	message="$message ($choice) "
	read -u1 -p "$message" answer
	[ "$answer" = "" ] && answer=$default
	answer=$(echo "$answer" | tr "[:upper:]" "[:lower:]")
	[ "$answer" = "y" ] && return 0
	[ "$answer" = "yes" ] && return 0
	return 1
}

readvar() {
	for var in $@; do
		varname=$(echo $var | sed "s/\([a-z]\)\([A-Z]\)/\\1 \\2/g")
		if [ "$AUTOMATIC" = "yes" ]; then
			echo "$varname: ${!var}"
		else
			read -e -p "$varname: " -i "${!var}" $var
		fi
	done
}

update_env() {
	var=$1
	shift
	val="$@"
	if egrep -q "^[# ]*${var}=($val|\"$val\"|'$val')" $ENV_FILE; then
		return
	elif egrep -q "^[# ]*${var}=" $ENV_FILE; then
		sed -i~ "s/^[# ]*${var}=.*/${var}=${val}/" $ENV_FILE
		log "  updated ${var} in $ENV_FILE"
	else
		echo "${var}=${val}" >>$ENV_FILE
		log "  added ${var} to $ENV_FILE"
	fi
}

ucfirst() {
	upper=$(echo $@ | cut -c 1 | tr "[:lower:]" "[:upper:]")
	lower=$(echo $@ | cut -c 2- | tr "[:upper:]" "[:lower:]")

	echo "$upper$lower"
}

get_config() {
	[ -z "${ENV_PATTERN:-}" ] && log 1 "$(system_message error_env_pattern_missing)" && return 1
	set | egrep "${ENV_PATTERN:-}" || log 1 "$(system_message error_empty_config)"
}

usage() {
	if [ ! "$USAGE" ]; then
		PAR=$(echo $OPTS | sed 's/.://g' | grep -v "^$" | sed "s/\([a-zA-Z0-9]*\)/[-\1]/g")
		PAROPT=$(echo $OPTS | sed "s/-://" | sed 's/\(.\)/\1\//g' |
			sed 's/\(.\)\/:\//[-\1 <value>] /g' |
			sed "s/.\///g")
		USAGE=$(echo $PGM $PAR $PAROPT "[...]" | sed "s/  / /g")
	fi
	echo "usage: $USAGE"
}

help() {
	usage
	[ -n "${HELP:-}" ] && echo "$HELP"
}

detailed_help() {
	cat $BASEDIR/app/doc/help.txt
	end
}

## Mum Tools

wp() {
	WP_CLI_PHP_ARGS="-d memory_limit=${WP_MEMORY_LIMIT:-512M}" \
		"$BASEDIR/vendor/bin/wp" ${allow_root:+"$allow_root"} "$@"
}

# Run from inside the site directory: that is how the environment serving it
# decides which database and which PHP the command gets.
wp_server() {
	cd "$MUM_SERVER_DIR" && wp --path="$MUM_SERVER_DIR" "$@"
}

wp_client() {
	cd "$MUM_CLIENT_DIR" && wp --path="$MUM_CLIENT_DIR" "$@"
}

random_password() {
	length=$(echo "${1:-16}" | sed "s/[^0-9]//g" | egrep "^[0-9]+$")
	[ -n "$length" ] || length=16

	echo $(LC_ALL=C tr -dc "[:alnum:]" </dev/urandom | head -c$length)
}

debug "APP_ENV ${APP_ENV:-empty} - $BASH_SOURCE:$LINENO"
APP_ENV=${APP_ENV:-local}

# Preprocess env modifier options
for o; do
	case $o in
	--testing | --tests | --test)
		debug "opt --testing"
		APP_ENV=testing
		;;
	--prod | --production)
		debug "opt --production"
		APP_ENV=production
		;;
	--local | --testing | --dev | --production)
		debug "opt --$o"
		APP_ENV=${o/--/}
		;;
	esac
done

debug "APP_ENV ${APP_ENV:-empty} - $BASH_SOURCE:$LINENO"

[ -f "$BASEDIR/.env" ] || log "No .env, using defaults, copy $BASEDIR/.env.example as .env and edit adjust to your needs"
for path in "$BASEDIR" "$BASEDIR/${APP_ENV}"; do
	[ -f "$path/.env.${APP_ENV}" ] && source "$path/.env.${APP_ENV}" ||
		[ -f "$path/.env" ] && source "$path/.env" ||
		true
done

## Read command line arguments

# Default options, may be expanded or overridden in parent script
OPTS="${OPTS:-hqv}"
LONGOPTS="${LONGOPTS:+${LONGOPTS},}testing,dev,help,quiet,verbose"
SYNTAX="${SYNTAX:-$(echo $(
	echo $OPTS | sed "s/-://g" | sed "s/\(.*\)/[-\\1] [<args>]/g" | sed "s/\(.\):/] [-\\1 <value>/g"
	echo $LONGOPTS | sed "s/,/] [--/g; s/^/[--/; s/$/]/"
))}"

USAGE=${USAGE:-$PGM $SYNTAX}
allow_root=

ARGS=()
for o; do
	case $o in
	# -p | --path)
	# 	debug "opt $o set to $2"
	# 	;;
	-h | --help)
		debug "opt --help"
		help
		end
		;;
	-q | --quiet)
		debug "opt --quiet"
		STDOUT="/dev/null"
		QUIET=yes
		DEBUG=no
		;;
	--testing | --tests | --test) shift ;;
	--prod | --production) shift ;;
	--local | --testing | --dev | --production) shift ;;
	-v | --verbose)
		STDERR="&1"
		DEBUG=yes
		debug "opt --verbose"
		;;
	*)
		ARGS+=("$o")
		;;
	esac
done

[ ${ERROR:-} ] && usage && echo && die "$ERROR"

# Back to the script, which parses its own from here. Positional parameters set
# in a sourced file are the caller's, which is what makes this work at all.
set -- ${ARGS[@]+"${ARGS[@]}"}

[ "$#" -eq 0 ] || debug "args left for the script: $*"

# And now the environment's own file, which wins over .env. After the options,
# because --testing is what decides which file that is -- it is not an override
# like the others, it is the question the others are answered in.
#
# No file, nothing to say: .env alone is a complete answer, and dev is the
# environment that needs none.

## Final setup

debug "APP_ENV ${APP_ENV:-empty} - $BASH_SOURCE:$LINENO"

case $APP_ENV in
dev)
	sites_dir=dev
	;;
testing | tests)
	sites_dir=tests/sites
	;;
production | prod)
	sites_dir=public
	;;
*)
	sites_dir=builds/sites/$APP_ENV
	;;
esac

debug "APP_ENV ${APP_ENV:-empty} - $BASH_SOURCE:$LINENO"

MUM_SERVER_SLUG=${MUM_SERVER_SLUG:-mum-server}
MUM_SERVER_HOST=${MUM_SERVER_HOST:-${MUM_SERVER_SLUG}-$APP_ENV.test}
MUM_SERVER_URL=${MUM_SERVER_URL:-https://$MUM_SERVER_HOST}
MUM_SERVER_DB=${MUM_SERVER_DB:-mum_server_$APP_ENV}
MUM_SERVER_DIR=${MUM_SERVER_DIR:-$sites_dir/$MUM_SERVER_SLUG-$APP_ENV-site}

MUM_CLIENT_SLUG=${MUM_CLIENT_SLUG:-mum-client}
MUM_CLIENT_HOST=${MUM_CLIENT_HOST:-${MUM_CLIENT_SLUG}-$APP_ENV.test}
MUM_CLIENT_URL=${MUM_CLIENT_URL:-https://$MUM_CLIENT_HOST}
MUM_CLIENT_DB=${MUM_CLIENT_DB:-mum_client_$APP_ENV}
MUM_CLIENT_DIR=${MUM_CLIENT_DIR:-$sites_dir/$MUM_CLIENT_SLUG-$APP_ENV-site}

MUM_DEMO_VERSION=${MUM_DEMO_VERSION:-1.5}
MUM_RELEASE_VERSION=${MUM_RELEASE_VERSION:-1.5}
MUM_CLIENT_VERSION=${MUM_CLIENT_VERSION:-1.4}

db_slug="mum_${APP_ENV}"
DB_HOST=${DB_HOST:-localhost}
DB_NAME=${DB_NAME:-${db_slug}}
DB_USER=${DB_USER:--${db_slug}}
DB_PASSWORD=${DB_PASSWORD:-}
TABLE_PREFIX=${TABLE_PREFIX:-${db_slug}_}
DB_CHARSET=${DB_CHARSET:-utf8mb4}
DB_COLLATE=${DB_COLLATE:-}

UPDATE_SERVER=${UPDATE_SERVER:-$MUM_SERVER_HOST}
ACCESS_KEY="(deprecated)"
MUM_PUSH_KEY_ID=${MUM_PUSH_KEY_ID:-mum_push}
MUM_PUSH_KEY_ID=UPDATEPULSE_P_${MUM_PUSH_KEY_ID/UPDATEPULSE_P_/}
MUM_PUSH_KEY=${MUM_PUSH_KEY:-}

ADMIN_USER=${ADMIN_USER:-admin}
ADMIN_PASSWORD=${ADMIN_PASSWORD:-}
ADMIN_EMAIL=${ADMIN_EMAIL:-admin@mum-${APP_ENV}.test}

GITHUB_TOKEN=${GITHUB_TOKEN:-}

ENV_FILE=$BASEDIR/$(echo .env.${APP_ENV} | sed "s/.local$//")
for var in ADMIN_PASSWORD DB_PASSWORD MUM_PUSH_KEY; do
	if [ -z "${!var:-}" ]; then
		log "${var} not set"
		echo $var | grep -q "_KEY" && length=32 || length=
		val=$(random_password $length)
		eval ${var}="$val"
		log "  generated $val"
		update_env $var "$val"
	fi
done
