#!/usr/bin/env php
<?php
/**
 * Push a plugin or theme to an UpdatePulse Server through its Package API.
 *
 * This is the client side of the ingestion loop: a site (or a build step)
 * publishes a package upward using its own scoped API key, with no filesystem
 * or sudo access to the server. It is used by `mum-sandbox publish` today, and
 * is the basis of the push-based ingestion agent (see PLAN.md, phase 6).
 *
 * Usage:
 *   mum-push --server URL --key-id ID --key SECRET [--type plugin|theme] <dir|zip>
 */

$defaults = array(
	'server' => null,
	'key-id' => null,
	'key'    => null,
	'type'   => null,
);

// getopt() gives the flexibility anybody expects of a command: --key-id ID and
// --key-id=ID both, in any order, and it stops where the options do.
$rest    = 0;
$given   = getopt( '', array( 'server:', 'key-id:', 'key:', 'type:' ), $rest );
$options = array_merge( $defaults, is_array( $given ) ? $given : array() );

// getopt() drops what it does not know without a word, and a typo that silently
// does nothing is worse than one that stops.
foreach ( array_slice( $argv, 1, $rest - 1 ) as $arg ) {
	if ( '--' === substr( $arg, 0, 2 ) ) {
		$name = strtok( substr( $arg, 2 ), '=' );

		if ( ! array_key_exists( $name, $defaults ) ) {
			fail( "unknown option --$name" );
		}
	}
}

$source = isset( $argv[ $rest ] ) ? $argv[ $rest ] : null;

foreach ( array( 'server', 'key-id', 'key' ) as $required ) {
	if ( empty( $options[ $required ] ) ) {
		fail( "missing --$required" );
	}
}

if ( ! $source ) {
	fail( 'missing package directory or zip file' );
}

$server = rtrim( $options['server'], '/' );
$source = rtrim( $source, '/' );

if ( ! file_exists( $source ) ) {
	fail( "no such file or directory: $source" );
}

$slug     = basename( $source, '.zip' );
$zip      = is_dir( $source ) ? build_zip( $source, $slug ) : $source;
$type     = $options['type'] ? $options['type'] : detect_type( $source );
$version  = read_version( $source );

info( sprintf( 'pushing %s%s as %s', $slug, $version ? " $version" : '', $type ) );

$token = get_token( $server, $options['key-id'], $options['key'] );

// The API refuses to overwrite through `add`, so upload new packages with
// `add` and existing ones with `edit`.
$result = upload( $server, $token, 'add', $slug, $type, $zip );

if ( isset( $result['code'] ) && 'package_exists' === $result['code'] ) {
	info( 'package already exists, updating it' );
	$result = upload( $server, $token, 'edit', $slug, $type, $zip );
}

if ( is_dir( $source ) ) {
	unlink( $zip );
}

if ( isset( $result['code'] ) ) {
	fail( sprintf( '%s: %s', $result['code'], $result['message'] ) );
}

// Reported from the package itself: the API answers with the metadata it had
// cached before re-reading the archive.
done( sprintf( '%s%s published to %s', $slug, $version ? " $version" : '', $server ) );

/**
 * Acquire a reusable token for the package API.
 *
 * The private key never travels: it signs a timestamped payload, and the
 * server matches that signature against the key it holds for this key id.
 */
function get_token( $server, $key_id, $key ) {
	$timestamp = time();
	$payload   = array( 'api' => 'package' );
	$str       = base64_encode( $key_id . json_encode( $payload, JSON_NUMERIC_CHECK ) );
	$time_key  = hash_hmac( 'sha256', $timestamp, $key, true );
	$signature = hash_hmac( 'sha256', $str, $time_key );

	$response = request(
		$server . '/updatepulse-server-token/',
		$payload,
		array(
			'X-UpdatePulse-API-Credentials: ' . $timestamp . '|' . $key_id,
			'X-UpdatePulse-API-Signature: ' . $signature,
		)
	);

	if ( empty( $response['nonce'] ) ) {
		fail( 'could not acquire a token: ' . json_encode( $response ) );
	}

	return $response['nonce'];
}

function upload( $server, $token, $action, $slug, $type, $zip ) {
	return request(
		$server . '/updatepulse-server-package-api/',
		array(
			'action'     => $action,
			'package_id' => $slug,
			'type'       => $type,
			'api_token'  => $token,
			'file'       => new CURLFile( $zip, 'application/zip', basename( $zip ) ),
		),
		array( 'File-Hash: ' . hash_file( 'sha256', $zip ) )
	);
}

/**
 * POST to the server. Private API actions are rejected when their parameters
 * are passed in the query string, so everything travels as form fields.
 */
function request( $url, $fields, $headers ) {
	$curl = curl_init();

	curl_setopt_array(
		$curl,
		array(
			CURLOPT_URL            => $url,
			CURLOPT_POST           => true,
			CURLOPT_POSTFIELDS     => $fields,
			CURLOPT_HTTPHEADER     => $headers,
			CURLOPT_RETURNTRANSFER => true,
			CURLOPT_TIMEOUT        => 120,
		)
	);

	// Local sandbox sites use a locally-trusted mkcert CA that PHP's bundle
	// does not know about; anything else must validate normally.
	if ( preg_match( '@^https://[^/]+\.test(/|$)@', $url ) ) {
		curl_setopt( $curl, CURLOPT_SSL_VERIFYPEER, false );
	}

	$body  = curl_exec( $curl );
	$error = curl_error( $curl );

	curl_close( $curl );

	if ( $error ) {
		fail( "request to $url failed: $error" );
	}

	$decoded = json_decode( $body, true );

	if ( null === $decoded ) {
		fail( "unexpected response from $url: " . substr( $body, 0, 200 ) );
	}

	return $decoded;
}

/**
 * What a package says it does not distribute.
 *
 * The very file the wordpress.org deploy already reads, so a package reaches
 * both channels carrying the same thing. Without it a plugin ships its own
 * test suite and its composer dependencies to every site it updates — enough,
 * here, to be refused by the server outright.
 */
function distignore( $dir ) {
	$file = $dir . '/.distignore';

	if ( ! is_readable( $file ) ) {
		return array();
	}

	$patterns = array();

	foreach ( file( $file, FILE_IGNORE_NEW_LINES ) as $line ) {
		$line = trim( $line );

		if ( '' !== $line && 0 !== strpos( $line, '#' ) ) {
			$patterns[] = $line;
		}
	}

	// assets/ stays in: the wordpress.org deploy strips it on its way to
	// trunk, and the package server needs it in the archive, since a package
	// can reach that server without ever passing through here.

	return $patterns;
}

function distignored( $relative, array $patterns ) {
	$segments = explode( '/', $relative );

	foreach ( $patterns as $pattern ) {
		$anchored = 0 === strpos( $pattern, '/' );
		$pattern  = trim( $pattern, '/' );

		if ( '' === $pattern ) {
			continue;
		}

		// A leading slash anchors: /tests/ is the package's own suite, not
		// some library's tests/ directory further down.
		if ( $anchored ) {
			if ( fnmatch( $pattern, $segments[0] ) ) {
				return true;
			}

			continue;
		}

		foreach ( $segments as $segment ) {
			if ( fnmatch( $pattern, $segment ) ) {
				return true;
			}
		}
	}

	return false;
}

function build_zip( $dir, $slug ) {
	$path     = realpath( $dir );
	$archive  = sys_get_temp_dir() . '/' . $slug . '-' . getmypid() . '.zip';
	$patterns = distignore( $path );
	$zip      = new ZipArchive();

	if ( true !== $zip->open( $archive, ZipArchive::CREATE | ZipArchive::OVERWRITE ) ) {
		fail( "could not create an archive for $dir" );
	}

	$files = new RecursiveIteratorIterator(
		new RecursiveDirectoryIterator( $path, FilesystemIterator::SKIP_DOTS )
	);

	foreach ( $files as $file ) {
		$relative = substr( $file->getPathname(), strlen( $path ) + 1 );

		// Version control and build leftovers have no place in a package.
		if ( preg_match( '@(^|/)(\.git|node_modules|\.DS_Store)(/|$)@', $relative ) ) {
			continue;
		}

		if ( distignored( $relative, $patterns ) ) {
			continue;
		}

		// The archive must contain the package in a folder named after its slug.
		$zip->addFile( $file->getPathname(), $slug . '/' . $relative );
	}

	if ( ! $zip->close() ) {
		fail( "could not write an archive for $dir" );
	}

	return $archive;
}

/**
 * What makes a theme is not a style.css — plenty of plugins ship one — but a
 * style.css declaring a Theme Name, which is what WordPress itself looks for.
 */
function detect_type( $source ) {
	if ( is_dir( $source ) ) {
		return declares_theme( @file_get_contents( $source . '/style.css' ) ) ? 'theme' : 'plugin';
	}

	$zip = new ZipArchive();

	if ( true !== $zip->open( $source ) ) {
		return 'plugin';
	}

	$type = 'plugin';

	for ( $i = 0; $i < $zip->numFiles; $i++ ) {
		$name = $zip->getNameIndex( $i );

		// Only the archive's own top-level folder counts.
		if ( ! preg_match( '@^[^/]+/style\.css$@', $name ) ) {
			continue;
		}

		if ( declares_theme( $zip->getFromIndex( $i, 8192 ) ) ) {
			$type = 'theme';
		}

		break;
	}

	$zip->close();

	return $type;
}

function declares_theme( $stylesheet ) {
	return $stylesheet && preg_match( '/^[ \t\/*#@]*Theme Name:\s*\S/mi', $stylesheet );
}

function read_version( $source ) {
	if ( ! is_dir( $source ) ) {
		return null;
	}

	// A theme declares its version in style.css, and its PHP files may carry a
	// bundled library's header instead — so ask the right file, not the first.
	$stylesheet = $source . '/style.css';

	if ( declares_theme( @file_get_contents( $stylesheet ) ) ) { // phpcs:ignore WordPress.PHP.NoSilencedErrors
		if ( preg_match( '/^[ \t\/*#@]*Version:\s*(.+)$/mi', file_get_contents( $stylesheet ), $matches ) ) {
			return trim( $matches[1] );
		}

		return null;
	}

	foreach ( glob( $source . '/*.php' ) as $file ) {
		if ( preg_match( '/^[ \t\/*#@]*Version:\s*(.+)$/mi', file_get_contents( $file ), $matches ) ) {
			return trim( $matches[1] );
		}
	}

	return null;
}

function info( $message ) {
	fwrite( STDERR, "\033[1;33mmum-push:\033[0m $message\n" );
}

function done( $message ) {
	fwrite( STDERR, "\033[0;32mmum-push:\033[0m $message\n" );
}

function fail( $message ) {
	fwrite( STDERR, "\033[1;31mmum-push:\033[0m $message\n" );
	exit( 1 );
}
